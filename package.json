{
  "name": "dsh-evermemory",
  "version": "0.1.0",
  "description": "Cross-session long-term memory and behavioural rules for DeepSeek Harness — four memory layers in SQLite, zero-LLM distillation, and a prefix-cache-friendly injection model",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "sqlite",
    "agent-memory",
    "long-term-memory"
  ],
  "license": "MIT",
  "author": "dsh-evermemory contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sread10/dsh-evermemory.git"
  },
  "homepage": "https://github.com/Sread10/dsh-evermemory#readme",
  "bugs": {
    "url": "https://github.com/Sread10/dsh-evermemory/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "PROPOSAL.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsdown && node scripts/bundle-client.mjs",
    "types": "tsc -b tsconfig.client.build.json && node scripts/clean.mjs --post",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "node --import ./scripts/peer-hooks.mjs --experimental-transform-types --test tests/*.test.ts",
    "test:watch": "node --import ./scripts/peer-hooks.mjs --experimental-transform-types --test --watch tests/*.test.ts",
    "prepack": "npm run build && npm run types && npm run check:tokens && npm run typecheck && npm test"
  },
  "comment": "No peerDependencies on purpose. Every @deepseek-ai/* package is injected by the DSH host process and none is installable from the registry at the installed runtime's version (installed 0.1.7-rc.2; published 0.0.1-rc.1 / 0.1.0-rc.6), so declaring them would only pin this package to an API it never runs against — and npm's arborist crashes outright placing a wildcard-versioned peer (place-dep.js:299). The plugin imports them as bare specifiers and the host resolves them. Type checking uses the shallow declarations in types/shims/.",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3"
  }
}
